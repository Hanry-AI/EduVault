<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bgForgot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/login_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardForgot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_notch_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="40dp"
            android:paddingBottom="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitleForgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvDescForgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nhập email để nhận liên kết đặt lại mật khẩu"
                android:textSize="14sp"
                android:textColor="#777777"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <!-- Email -->
            <EditText
                android:id="@+id/edtEmailForgot"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Email của bạn"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="18dp"
                android:textSize="15sp"
                android:textColor="#000"
                android:textColorHint="#9E9E9E"
                android:layout_marginBottom="20dp"/>

            <!-- Back to login -->
            <TextView
                android:id="@+id/tvBackLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại đăng nhập"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_gravity="center"/>

        </LinearLayout>

        <!-- Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendReset"
            android:layout_width="180dp"
            android:layout_height="70dp"
            android:text="Gửi liên kết"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"

            android:background="@android:color/transparent"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            app:elevation="0dp"
            app:rippleColor="#33FFFFFF"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="-12dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>