<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:paddingTop="40dp">

    <TextView
        android:id="@+id/tvUniTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:text="Dành cho những sinh viên xuất sắc nhất"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#18181B"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvUniSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        android:text="Tìm kiếm tài liệu học tập tốt nhất để chinh phục con đường học vấn."
        android:textSize="16sp"
        android:textColor="#71717A"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input_rounded"
        android:backgroundTint="#FEF3C7"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trường Đại học"
            android:textColor="#CA8A04"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#CA8A04"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="🎓 Trường Đại học Ngoại thương"
            android:textColor="#27272A"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="🎓 Trường Đại học FPT"
            android:textColor="#27272A"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="🎓 Trường Đại học Bách khoa Hà Nội"
            android:textColor="#27272A"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnSeeAllUnis"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="Xem tất cả"
            android:textColor="#18181B"
            android:backgroundTint="#FFFFFF"
            style="?attr/materialButtonOutlinedStyle"
            app:strokeColor="#E4E4E7"
            app:strokeWidth="1dp"
            app:cornerRadius="25dp"/>
    </LinearLayout>

</LinearLayout>