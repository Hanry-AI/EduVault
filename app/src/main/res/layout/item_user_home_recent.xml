<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="30dp"
    android:background="#F8FAFC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiếp tục học tập"
                android:textColor="#18181B"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theo dõi tiến độ học và tài liệu gần đây"
                android:textColor="#71717A"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xem tất cả"
            android:textColor="#EAB308"
            android:textStyle="bold"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- FILTERS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:scrollbars="none"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ACTIVE -->
            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Tất cả"
                android:textColor="#18181B"
                android:textStyle="bold"
                app:chipBackgroundColor="#EAB308"
                app:chipCornerRadius="22dp"
                android:layout_marginEnd="10dp"/>

            <!-- NORMAL -->
            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Tài liệu"
                android:textColor="#D4D4D8"
                app:chipBackgroundColor="#27272A"
                app:chipCornerRadius="22dp"
                android:layout_marginEnd="10dp"/>

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Quiz"
                android:textColor="#D4D4D8"
                app:chipBackgroundColor="#27272A"
                app:chipCornerRadius="22dp"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- MAIN CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="30dp"
        app:cardElevation="2dp"
        app:strokeColor="#E4E4E7"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- ITEM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <!-- ICON -->
                <LinearLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="#FEF3C7">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_document" />
                </LinearLayout>

                <!-- CONTENT -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kinh tế vi mô — Chương 3"
                        android:textColor="#18181B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ECO201 • Đã đọc 60%"
                        android:textColor="#71717A"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"/>

                    <!-- CUSTOM PROGRESS -->
                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="150dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="60"
                        android:progressBackgroundTint="#E5E7EB"
                        android:progressTint="#22C55E"/>
                </LinearLayout>

                <!-- TIME -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>