<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="18dp"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="32dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#18181B">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="26dp">

        <!-- GOLD GLOW -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:alpha="0.08"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="#EAB308"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- GREEN ACCENT -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0.05"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="#22C55E"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BADGE -->
        <TextView
            android:id="@+id/tvBannerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ STUDYAI"
            android:textColor="#FACC15"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Học thông minh hơn\nvới AI của bạn"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvBannerBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- DESC -->
        <TextView
            android:id="@+id/tvBannerDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tóm tắt tài liệu, tạo quiz và ghi chú thông minh từ chính nguồn học của bạn."
            android:textColor="#A1A1AA"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            app:layout_constraintTop_toBottomOf="@id/tvBannerTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BUTTON ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvBannerDesc">

            <!-- PRIMARY BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTryAI"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.4"
                android:layout_marginEnd="8dp"
                android:text="Thử StudyAI"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#EAB308"
                app:cornerRadius="18dp"
                app:elevation="0dp"/>

            <!-- SECONDARY BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadDoc"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Tải lên"
                android:textAllCaps="false"
                android:textColor="#D4D4D8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#27272A"
                app:cornerRadius="18dp"
                app:elevation="0dp"
                app:strokeColor="#3F3F46"
                app:strokeWidth="1dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>